# Kabisado Environment Variables
APP_NAME="Kabisado API"
APP_VERSION="1.0.0"
DEBUG=True

# SQLite Database
DATABASE_URL="sqlite:///./kabisado.db"
UPLOAD_DIR="./uploads"

# Gemini API Key (Never commit secrets to Git!)
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_FALLBACK_MODELS="gemini-3.8-flash"

# --- Web / auth (required in production) ---
DEBUG=false
GEMINI_ENABLED=false            # global kill switch; keep false until billing/terms are reviewed
ALLOWED_ORIGINS="http://localhost:5173"
JWT_SECRET="generate-a-long-random-string-at-least-32-characters"
COOKIE_SECURE=false             # local http dev only; must be true in production
AUTO_CREATE_SCHEMA=true         # local dev convenience; production uses `alembic upgrade head`
